      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n:root {\n  --canvas: #F5F2EC;\n  --surface: #FFFFFF;\n  --surface-soft: #FAF8F3;\n  --ink: #1E2B2A;\n  --ink-soft: #5B6B69;\n  --teal: #1B4B4F;\n  --teal-deep: #0F3436;\n  --sage: #6E9184;\n  --clay: #C97B4A;\n  --clay-soft: #E8A26F;\n  --line: #E4DFD4;\n  --line-strong: #D4CEC0;\n  --success: #2F7957;\n  --success-soft: #E6F2EA;\n  --warning: #9A6A19;\n  --warning-soft: #FFF3D6;\n  --danger: #A6443D;\n  --danger-soft: #FBE8E4;\n  --shadow-shell: 0 28px 72px -42px rgba(15, 52, 54, .42);\n  --shadow-panel: 0 12px 30px -26px rgba(15, 52, 54, .35);\n  --radius-sm: 10px;\n  --radius-md: 14px;\n  --radius-lg: 18px;\n  --radius-xl: 22px;\n  --font-display: 'Outfit', sans-serif;\n  --font-body: 'Inter', sans-serif;\n}\n\nbody {\n  margin: 0;\n  background: var(--canvas);\n  color: var(--ink);\n  font-family: var(--font-body);\n  font-size: 14px;\n  line-height: 1.5;\n  -webkit-font-smoothing: antialiased;\n}\n\nbutton,\ninput {\n  font: inherit;\n}\n\nbutton,\na {\n  -webkit-tap-highlight-color: transparent;\n}\n\nbutton:focus-visible,\na:focus-visible,\ninput:focus-visible {\n  outline: 3px solid rgba(201, 123, 74, .36);\n  outline-offset: 3px;\n}\n\n.app-shell {\n  display: grid;\n  grid-template-columns: 248px minmax(0, 1fr);\n  width: 100%;\n  max-width: 1440px;\n  min-height: 1180px;\n  margin: 0 auto;\n  background: var(--surface);\n  box-shadow: var(--shadow-shell);\n}\n\n.sidebar {\n  display: flex;\n  flex-direction: column;\n  gap: 36px;\n  padding: 30px 20px 24px;\n  background: var(--surface);\n  border-right: 1px solid var(--line);\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  padding: 0 8px;\n  text-decoration: none;\n  color: var(--teal-deep);\n}\n\n.brand-mark {\n  display: grid;\n  width: 36px;\n  height: 36px;\n  place-items: center;\n  border-radius: 11px;\n  background: var(--clay);\n  color: var(--surface);\n  font-size: 21px;\n}\n\n.brand-copy {\n  display: grid;\n  gap: 0;\n  font-family: var(--font-display);\n  font-size: 19px;\n  font-weight: 800;\n  letter-spacing: -.6px;\n  line-height: 1;\n}\n\n.brand-copy span {\n  color: var(--clay);\n}\n\n.brand-caption {\n  margin-top: 5px;\n  color: var(--ink-soft);\n  font-family: var(--font-body);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1.3px;\n  line-height: 1;\n  text-transform: uppercase;\n}\n\n.sidebar-nav {\n  position: relative;\n  display: grid;\n  gap: 7px;\n}\n\n.sidebar-nav::before {\n  position: absolute;\n  top: 14px;\n  bottom: 14px;\n  left: 22px;\n  width: 1px;\n  background: var(--line);\n  content: '';\n}\n\n.nav-kicker {\n  margin: 0 0 12px 8px;\n  color: var(--ink-soft);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1.2px;\n  text-transform: uppercase;\n}\n\n.nav-item {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-height: 44px;\n  padding: 8px 10px;\n  border: 1px solid transparent;\n  border-radius: var(--radius-sm);\n  color: var(--ink-soft);\n  text-decoration: none;\n  font-size: 12px;\n  font-weight: 600;\n  transition: background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease;\n}\n\n.nav-item i {\n  display: grid;\n  width: 24px;\n  height: 24px;\n  place-items: center;\n  border: 1px solid var(--line);\n  border-radius: 50%;\n  background: var(--surface);\n  color: var(--teal);\n  font-size: 14px;\n}\n\n.nav-item:hover {\n  border-color: var(--line);\n  background: var(--surface-soft);\n  color: var(--teal-deep);\n  transform: translateX(2px);\n}\n\n.nav-item.active {\n  border-color: rgba(27, 75, 79, .16);\n  background: #EEF4F1;\n  color: var(--teal-deep);\n}\n\n.nav-item.active::after {\n  position: absolute;\n  right: -21px;\n  width: 3px;\n  height: 25px;\n  border-radius: 2px 0 0 2px;\n  background: var(--clay);\n  content: '';\n}\n\n.nav-item.active i {\n  border-color: var(--teal);\n  background: var(--teal);\n  color: var(--surface);\n}\n\n.sidebar-bottom {\n  display: grid;\n  gap: 14px;\n  margin-top: auto;\n  padding: 16px 10px 0;\n  border-top: 1px solid var(--line);\n}\n\n.sidebar-note {\n  display: flex;\n  align-items: flex-start;\n  gap: 9px;\n  color: var(--ink-soft);\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n.sidebar-note i {\n  margin-top: 2px;\n  color: var(--success);\n  font-size: 15px;\n}\n\n.sidebar-foot {\n  color: var(--ink-soft);\n  font-size: 10px;\n}\n\n.workspace {\n  min-width: 0;\n  padding: 28px 44px 34px;\n  background: var(--canvas);\n}\n\n.topbar {\n  display: grid;\n  grid-template-columns: minmax(180px, 1fr) minmax(350px, 1.4fr) auto;\n  align-items: center;\n  gap: 24px;\n  min-height: 44px;\n}\n\n.breadcrumb {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--ink-soft);\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.breadcrumb strong {\n  color: var(--ink);\n  font-weight: 700;\n}\n\n.breadcrumb i {\n  color: var(--clay);\n  font-size: 13px;\n}\n\n.global-search {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 0;\n  height: 42px;\n  padding: 0 12px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-md);\n  background: var(--surface);\n  color: var(--ink-soft);\n  box-shadow: var(--shadow-panel);\n}\n\n.global-search i {\n  color: var(--teal);\n  font-size: 17px;\n}\n\n.global-search span {\n  min-width: 0;\n  flex: 1;\n  overflow: hidden;\n  color: var(--ink-soft);\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.search-hint {\n  flex: 0 0 auto;\n  padding: 3px 6px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  color: var(--ink-soft);\n  font-family: var(--font-display);\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.workspace-context {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 14px;\n  color: var(--ink-soft);\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.context-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.context-status::before {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--success);\n  content: '';\n}\n\n.avatar {\n  display: grid;\n  width: 32px;\n  height: 32px;\n  place-items: center;\n  border: 1px solid var(--line-strong);\n  border-radius: 50%;\n  background: var(--teal-deep);\n  color: var(--surface);\n  font-family: var(--font-display);\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.welcome {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 278px;\n  gap: 28px;\n  align-items: end;\n  padding: 58px 0 42px;\n  border-bottom: 1px solid var(--line);\n}\n\n.eyebrow {\n  margin: 0 0 10px;\n  color: var(--clay);\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1.8px;\n  text-transform: uppercase;\n}\n\n.welcome h1 {\n  max-width: 620px;\n  margin: 0;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: clamp(38px, 4vw, 56px);\n  font-weight: 700;\n  letter-spacing: -2.3px;\n  line-height: .98;\n}\n\n.welcome-copy {\n  max-width: 560px;\n  margin: 17px 0 24px;\n  color: var(--ink-soft);\n  font-size: 14px;\n  line-height: 1.65;\n}\n\n.welcome-actions {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n\n.primary-action,\n.text-action {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 42px;\n  border-radius: var(--radius-sm);\n  text-decoration: none;\n  font-size: 12px;\n  font-weight: 700;\n  transition: transform .18s ease, background .18s ease, border-color .18s ease;\n}\n\n.primary-action {\n  gap: 8px;\n  padding: 0 17px;\n  background: var(--clay);\n  color: var(--surface);\n}\n\n.primary-action:hover {\n  background: #B96E40;\n  transform: translateY(-2px);\n}\n\n.text-action {\n  min-height: auto;\n  color: var(--teal-deep);\n}\n\n.text-action:hover {\n  color: var(--clay);\n}\n\n.text-action i {\n  margin-left: 5px;\n  font-size: 15px;\n}\n\n.trial-note {\n  align-self: stretch;\n  display: grid;\n  align-content: space-between;\n  gap: 22px;\n  padding: 18px 18px 16px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-lg);\n  background: var(--surface);\n  box-shadow: var(--shadow-panel);\n}\n\n.trial-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: var(--ink-soft);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .7px;\n  text-transform: uppercase;\n}\n\n.trial-badge {\n  padding: 4px 7px;\n  border-radius: 6px;\n  background: var(--success-soft);\n  color: var(--success);\n  font-size: 9px;\n  letter-spacing: .3px;\n}\n\n.trial-note strong {\n  display: block;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 25px;\n  letter-spacing: -.8px;\n  line-height: 1;\n}\n\n.trial-note p {\n  margin: 7px 0 0;\n  color: var(--ink-soft);\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n.trial-line {\n  height: 1px;\n  background: var(--line);\n}\n\n.section {\n  padding-top: 34px;\n}\n\n.section-heading {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 15px;\n}\n\n.section-heading h2 {\n  margin: 0;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 22px;\n  font-weight: 700;\n  letter-spacing: -.7px;\n}\n\n.section-heading p {\n  margin: 4px 0 0;\n  color: var(--ink-soft);\n  font-size: 11px;\n}\n\n.section-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  color: var(--teal);\n  font-size: 11px;\n  font-weight: 700;\n  text-decoration: none;\n}\n\n.section-link:hover {\n  color: var(--clay);\n}\n\n.shortcut-grid {\n  display: grid;\n  grid-template-columns: 1.18fr 1.18fr .82fr .82fr;\n  grid-auto-rows: 92px;\n  gap: 10px;\n}\n\n.shortcut {\n  position: relative;\n  display: flex;\n  align-items: flex-end;\n  gap: 12px;\n  min-width: 0;\n  padding: 15px;\n  overflow: hidden;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-md);\n  background: var(--surface);\n  color: var(--ink);\n  text-decoration: none;\n  transition: border-color .18s ease, transform .18s ease, background .18s ease;\n}\n\n.shortcut:hover {\n  border-color: var(--clay-soft);\n  background: #FFFDFC;\n  transform: translateY(-2px);\n}\n\n.shortcut i {\n  display: grid;\n  width: 32px;\n  height: 32px;\n  flex: 0 0 auto;\n  place-items: center;\n  border: 1px solid rgba(27, 75, 79, .16);\n  border-radius: 10px;\n  background: #EEF4F1;\n  color: var(--teal);\n  font-size: 18px;\n}\n\n.shortcut-copy {\n  min-width: 0;\n}\n\n.shortcut small {\n  display: block;\n  margin-bottom: 3px;\n  color: var(--clay);\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n}\n\n.shortcut strong {\n  display: block;\n  overflow: hidden;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 15px;\n  letter-spacing: -.3px;\n  line-height: 1.1;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.shortcut p {\n  margin: 4px 0 0;\n  color: var(--ink-soft);\n  font-size: 10px;\n  line-height: 1.35;\n}\n\n.shortcut-feature {\n  grid-row: span 2;\n  align-items: flex-start;\n  flex-direction: column;\n  justify-content: space-between;\n  padding: 18px;\n  background: var(--teal-deep);\n  color: var(--surface);\n}\n\n.shortcut-feature:hover {\n  border-color: var(--teal);\n  background: var(--teal);\n}\n\n.shortcut-feature i {\n  border-color: rgba(255, 255, 255, .22);\n  background: rgba(255, 255, 255, .08);\n  color: var(--clay-soft);\n}\n\n.shortcut-feature small,\n.shortcut-feature strong,\n.shortcut-feature p {\n  color: var(--surface);\n}\n\n.shortcut-feature small {\n  color: var(--clay-soft);\n}\n\n.shortcut-feature strong {\n  font-size: 21px;\n}\n\n.shortcut-feature p {\n  max-width: 180px;\n  color: rgba(255, 255, 255, .7);\n  font-size: 11px;\n}\n\n.shortcut-calc {\n  grid-column: span 2;\n  background: var(--surface-soft);\n}\n\n.shortcut-calc strong {\n  font-size: 18px;\n}\n\n.shortcut-mark {\n  position: absolute;\n  top: 14px;\n  right: 15px;\n  color: var(--line-strong);\n  font-size: 16px;\n}\n\n.station-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.28fr) minmax(310px, .72fr);\n  gap: 14px;\n  align-items: start;\n}\n\n.panel {\n  min-width: 0;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-lg);\n  background: var(--surface);\n  box-shadow: var(--shadow-panel);\n}\n\n.panel-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 18px 20px 14px;\n  border-bottom: 1px solid var(--line);\n}\n\n.panel-kicker {\n  margin: 0 0 4px;\n  color: var(--clay);\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1.2px;\n  text-transform: uppercase;\n}\n\n.panel h3 {\n  margin: 0;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 20px;\n  letter-spacing: -.5px;\n  line-height: 1.1;\n}\n\n.panel-subtitle {\n  margin: 5px 0 0;\n  color: var(--ink-soft);\n  font-size: 11px;\n}\n\n.panel-code {\n  padding: 5px 8px;\n  border-radius: 7px;\n  background: var(--surface-soft);\n  color: var(--teal);\n  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.flat-tabs {\n  display: flex;\n  gap: 20px;\n  padding: 0 20px;\n  border-bottom: 1px solid var(--line);\n}\n\n.flat-tab {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  min-height: 42px;\n  border: 0;\n  background: transparent;\n  color: var(--ink-soft);\n  cursor: pointer;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.flat-tab::after {\n  position: absolute;\n  right: 0;\n  bottom: -1px;\n  left: 0;\n  height: 2px;\n  background: transparent;\n  content: '';\n}\n\n.flat-tab.active {\n  color: var(--teal-deep);\n}\n\n.flat-tab.active::after {\n  background: var(--clay);\n}\n\n.gasometry-body {\n  padding: 17px 20px 19px;\n}\n\n.gasometry-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1.12fr) minmax(210px, .88fr);\n  gap: 18px;\n}\n\n.form-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 10px;\n}\n\n.form-heading strong {\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 14px;\n}\n\n.form-heading span {\n  color: var(--ink-soft);\n  font-size: 10px;\n}\n\n.gasometry-form {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 9px 10px;\n}\n\n.field {\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n}\n\n.field.patient {\n  grid-column: span 2;\n}\n\n.field label {\n  color: var(--ink-soft);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.field input {\n  width: 100%;\n  min-width: 0;\n  height: 34px;\n  padding: 0 10px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  outline: 0;\n  background: var(--surface-soft);\n  color: var(--ink);\n  font-size: 11px;\n  transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;\n}\n\n.field input::placeholder {\n  color: #9AA6A3;\n}\n\n.field input:focus {\n  border-color: var(--teal);\n  background: var(--surface);\n  box-shadow: 0 0 0 3px rgba(27, 75, 79, .10);\n}\n\n.field-ref {\n  color: var(--ink-soft);\n  font-size: 9px;\n}\n\n.form-actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 12px;\n}\n\n.action-button {\n  min-height: 38px;\n  padding: 0 15px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  cursor: pointer;\n  font-size: 11px;\n  font-weight: 700;\n  transition: transform .18s ease, background .18s ease, border-color .18s ease;\n}\n\n.action-button.primary {\n  background: var(--teal);\n  color: var(--surface);\n}\n\n.action-button.secondary {\n  border-color: var(--line);\n  background: var(--surface-soft);\n  color: var(--teal-deep);\n}\n\n.action-button:hover {\n  transform: translateY(-1px);\n}\n\n.action-button.primary:hover {\n  background: var(--teal-deep);\n}\n\n.result-column {\n  display: grid;\n  align-content: start;\n  gap: 12px;\n  min-width: 0;\n}\n\n.result-label {\n  display: block;\n  margin-bottom: 6px;\n  color: var(--ink-soft);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.primary-result {\n  padding: 13px 14px;\n  border-left: 3px solid var(--success);\n  border-radius: 9px;\n  background: var(--success-soft);\n}\n\n.primary-result small {\n  color: var(--success);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.primary-result strong {\n  display: block;\n  margin-top: 3px;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 24px;\n  letter-spacing: -.7px;\n  line-height: 1.05;\n}\n\n.primary-result p {\n  margin: 6px 0 0;\n  color: var(--ink-soft);\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.metric-list {\n  border-top: 1px solid var(--line);\n}\n\n.metric-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  min-height: 31px;\n  border-bottom: 1px solid var(--line);\n  color: var(--ink-soft);\n  font-size: 10px;\n}\n\n.metric-row strong {\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 13px;\n}\n\n.result-note {\n  margin: 0;\n  color: var(--ink-soft);\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.classification-body {\n  padding: 16px 18px 17px;\n}\n\n.class-search {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  height: 36px;\n  padding: 0 10px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--surface-soft);\n}\n\n.class-search i {\n  color: var(--teal);\n  font-size: 15px;\n}\n\n.class-search span {\n  overflow: hidden;\n  color: var(--ink-soft);\n  font-size: 10px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.chapter-summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-top: 12px;\n  padding: 11px 12px;\n  border-left: 3px solid var(--clay);\n  background: var(--surface-soft);\n}\n\n.chapter-summary strong {\n  display: block;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 13px;\n}\n\n.chapter-summary span {\n  display: block;\n  margin-top: 2px;\n  color: var(--ink-soft);\n  font-size: 9px;\n}\n\n.chapter-count {\n  flex: 0 0 auto;\n  color: var(--teal);\n  font-family: var(--font-display);\n  font-size: 13px;\n  font-weight: 700;\n  text-align: right;\n}\n\n.tree {\n  height: 242px;\n  margin-top: 13px;\n  padding: 2px 0 2px 12px;\n  overflow: hidden;\n  border-left: 1px solid var(--line-strong);\n}\n\n.tree-item {\n  position: relative;\n  display: grid;\n  grid-template-columns: 20px 34px minmax(0, 1fr) 26px;\n  align-items: center;\n  gap: 6px;\n  min-height: 45px;\n  border-bottom: 1px solid var(--line);\n}\n\n.tree-item::before {\n  position: absolute;\n  top: 22px;\n  left: -13px;\n  width: 11px;\n  height: 1px;\n  background: var(--line-strong);\n  content: '';\n}\n\n.tree-toggle {\n  display: grid;\n  width: 20px;\n  height: 20px;\n  place-items: center;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: var(--surface);\n  color: var(--teal);\n  font-size: 12px;\n}\n\n.tree-level {\n  width: 3px;\n  height: 22px;\n  border-radius: 2px;\n  background: var(--teal);\n}\n\n.tree-code {\n  color: var(--teal-deep);\n  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.tree-name {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--ink);\n  font-size: 10px;\n  font-weight: 600;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.details-button {\n  display: grid;\n  width: 26px;\n  height: 26px;\n  place-items: center;\n  border: 1px solid var(--line);\n  border-radius: 7px;\n  background: var(--surface-soft);\n  color: var(--teal);\n  cursor: pointer;\n  font-size: 13px;\n}\n\n.details-button:hover {\n  border-color: var(--clay-soft);\n  color: var(--clay);\n}\n\n.class-footer {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 13px;\n  padding-top: 12px;\n  border-top: 1px solid var(--line);\n  color: var(--ink-soft);\n  font-size: 10px;\n}\n\n.class-footer strong {\n  color: var(--teal-deep);\n}\n\n.recent {\n  display: flex;\n  align-items: center;\n  gap: 0;\n  padding: 17px 0 2px;\n  border-top: 1px solid var(--line);\n}\n\n.recent-heading {\n  flex: 0 0 auto;\n  margin-right: 25px;\n  color: var(--teal-deep);\n  font-family: var(--font-display);\n  font-size: 15px;\n  font-weight: 700;\n}\n\n.recent-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  min-height: 26px;\n  padding: 0 18px;\n  border-left: 1px solid var(--line-strong);\n  color: var(--ink-soft);\n  font-size: 10px;\n  text-decoration: none;\n}\n\n.recent-item:hover {\n  color: var(--clay);\n}\n\n.recent-item i {\n  color: var(--teal);\n  font-size: 14px;\n}\n\n.mobile-nav {\n  display: none;\n}\n\n@media (max-width: 1099px) and (min-width: 768px) {\n  .app-shell {\n    grid-template-columns: 84px minmax(0, 1fr);\n    min-height: 1120px;\n  }\n\n  .sidebar {\n    align-items: center;\n    padding: 26px 12px 20px;\n  }\n\n  .brand {\n    padding: 0;\n  }\n\n  .brand-copy,\n  .brand-caption,\n  .nav-kicker,\n  .nav-item span,\n  .sidebar-note span,\n  .sidebar-foot {\n    display: none;\n  }\n\n  .sidebar-nav::before {\n    left: 50%;\n    transform: translateX(-50%);\n  }\n\n  .nav-item {\n    justify-content: center;\n    width: 48px;\n    padding: 8px 0;\n  }\n\n  .nav-item.active::after {\n    right: -13px;\n  }\n\n  .sidebar-bottom {\n    padding: 16px 0 0;\n  }\n\n  .sidebar-note {\n    justify-content: center;\n  }\n\n  .workspace {\n    padding: 26px 28px 32px;\n  }\n\n  .topbar {\n    grid-template-columns: 1fr minmax(260px, 1.2fr) auto;\n    gap: 14px;\n  }\n\n  .welcome {\n    grid-template-columns: minmax(0, 1fr) 230px;\n    padding: 44px 0 34px;\n  }\n\n  .shortcut-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    grid-auto-rows: 100px;\n  }\n\n  .shortcut-feature {\n    grid-row: span 2;\n  }\n\n  .shortcut-calc {\n    grid-column: span 1;\n  }\n\n  .station-grid,\n  .gasometry-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .gasometry-form {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .field.patient {\n    grid-column: span 3;\n  }\n\n  .result-column {\n    grid-template-columns: 1fr 1fr;\n    align-items: start;\n  }\n\n  .result-column .result-label,\n  .result-column .result-note {\n    grid-column: 1 / -1;\n  }\n\n  .primary-result {\n    min-height: 92px;\n  }\n\n  .metric-list {\n    border-top: 0;\n  }\n\n  .recent {\n    flex-wrap: wrap;\n    row-gap: 12px;\n  }\n}\n\n@media (max-width: 767px) {\n  .app-shell {\n    display: block;\n    min-height: 0;\n  }\n\n  .sidebar {\n    display: none;\n  }\n\n  .workspace {\n    padding: 20px 16px 24px;\n  }\n\n  .topbar {\n    grid-template-columns: 1fr auto;\n    gap: 14px 12px;\n  }\n\n  .breadcrumb {\n    min-width: 0;\n  }\n\n  .workspace-context {\n    gap: 8px;\n  }\n\n  .workspace-context .context-status {\n    display: none;\n  }\n\n  .global-search {\n    grid-column: 1 / -1;\n    order: 3;\n    width: 100%;\n  }\n\n  .welcome {\n    grid-template-columns: 1fr;\n    gap: 22px;\n    padding: 35px 0 28px;\n  }\n\n  .welcome h1 {\n    max-width: 430px;\n    font-size: clamp(34px, 11vw, 46px);\n    letter-spacing: -1.7px;\n  }\n\n  .welcome-copy {\n    margin-top: 14px;\n    font-size: 13px;\n  }\n\n  .trial-note {\n    min-height: 124px;\n  }\n\n  .section {\n    padding-top: 28px;\n  }\n\n  .section-heading {\n    align-items: flex-start;\n  }\n\n  .section-heading h2 {\n    font-size: 20px;\n  }\n\n  .section-link {\n    padding-top: 4px;\n  }\n\n  .shortcut-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    grid-auto-rows: 100px;\n    gap: 9px;\n  }\n\n  .shortcut {\n    gap: 8px;\n    padding: 12px;\n  }\n\n  .shortcut-feature {\n    grid-column: span 2;\n    grid-row: span 1;\n    flex-direction: row;\n    align-items: center;\n    padding: 13px;\n  }\n\n  .shortcut-feature strong {\n    font-size: 17px;\n  }\n\n  .shortcut-feature p {\n    display: none;\n  }\n\n  .shortcut-calc {\n    grid-column: span 2;\n  }\n\n  .shortcut strong,\n  .shortcut-calc strong {\n    font-size: 13px;\n  }\n\n  .shortcut p {\n    display: none;\n  }\n\n  .shortcut i {\n    width: 29px;\n    height: 29px;\n    border-radius: 8px;\n    font-size: 16px;\n  }\n\n  .station-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .panel-header {\n    padding: 16px 15px 13px;\n  }\n\n  .panel h3 {\n    font-size: 18px;\n  }\n\n  .flat-tabs {\n    gap: 16px;\n    padding: 0 15px;\n    overflow-x: auto;\n  }\n\n  .flat-tab {\n    flex: 0 0 auto;\n    min-height: 40px;\n  }\n\n  .gasometry-body,\n  .classification-body {\n    padding: 15px;\n  }\n\n  .gasometry-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .gasometry-form {\n    grid-template-columns: 1fr;\n  }\n\n  .field.patient {\n    grid-column: auto;\n  }\n\n  .form-actions {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .action-button {\n    min-height: 42px;\n  }\n\n  .result-column {\n    gap: 10px;\n  }\n\n  .primary-result strong {\n    font-size: 22px;\n  }\n\n  .tree {\n    height: 240px;\n  }\n\n  .tree-item {\n    grid-template-columns: 20px 24px minmax(0, 1fr) 30px;\n    min-height: 48px;\n  }\n\n  .tree-name {\n    font-size: 10px;\n    white-space: normal;\n  }\n\n  .details-button {\n    width: 30px;\n    height: 30px;\n  }\n\n  .recent {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 8px 0;\n    padding-top: 16px;\n  }\n\n  .recent-heading {\n    grid-column: 1 / -1;\n    margin: 0 0 2px;\n  }\n\n  .recent-item {\n    padding: 0 10px;\n  }\n\n  .recent-item:first-of-type {\n    padding-left: 0;\n    border-left: 0;\n  }\n\n  .mobile-nav {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 7px;\n    margin-top: 28px;\n    padding-top: 16px;\n    border-top: 1px solid var(--line);\n  }\n\n  .mobile-nav a {\n    display: grid;\n    justify-items: center;\n    gap: 4px;\n    min-height: 44px;\n    color: var(--ink-soft);\n    font-size: 9px;\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .mobile-nav i {\n    color: var(--teal);\n    font-size: 18px;\n  }\n\n  .mobile-nav a.active {\n    color: var(--teal-deep);\n  }\n\n  .mobile-nav a.active i {\n    color: var(--clay);\n  }\n}\n</style>\n<div class=\"app-shell\" data-kid=\"1\" data-name=\"app shell container\">\n    <aside aria-label=\"Navegação principal\" class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation\">\n        <a aria-label=\"Fisio Elite\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity link\" href=\"#overview\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"stethoscope icon\">\n                <i class=\"ti ti-stethoscope\" data-kid=\"1-1-1-1-1\">\n                </i>\n            </span>\n            <span class=\"brand-copy\" data-kid=\"1-1-1-2\" data-name=\"brand name and caption\">\n                Fisio\n                <span data-kid=\"1-1-1-2-1\" data-name=\"brand name accent\">\n                    Elite\n                </span>\n                <small class=\"brand-caption\" data-kid=\"1-1-1-2-2\" data-name=\"brand caption text\">\n                    Centro clínico\n                </small>\n            </span>\n        </a>\n        <nav class=\"sidebar-nav\" data-kid=\"1-1-2\" data-name=\"sidebar navigation list\">\n            <p class=\"nav-kicker\" data-kid=\"1-1-2-1\" data-name=\"sidebar navigation category kicker\">\n                Seu espaço\n            </p>\n            <a class=\"nav-item active\" data-kid=\"1-1-2-2\" data-name=\"active navigation item\" href=\"#overview\">\n                <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-2-1\" data-name=\"dashboard icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"active navigation label\">\n                    Visão geral\n                </span>\n            </a>\n            <a class=\"nav-item\" data-kid=\"1-1-2-3\" data-name=\"navigation item\" href=\"#shortcuts\">\n                <i class=\"ti ti-medical-cross\" data-kid=\"1-1-2-3-1\" data-name=\"medical cross icon\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"navigation label\">\n                    Especialidades\n                </span>\n            </a>\n            <a class=\"nav-item\" data-kid=\"1-1-2-4\" data-name=\"navigation item\" href=\"#classification\">\n                <i class=\"ti ti-notes\" data-kid=\"1-1-2-4-1\" data-name=\"notes icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\" data-name=\"navigation label\">\n                    Protocolos\n                </span>\n            </a>\n            <a class=\"nav-item\" data-kid=\"1-1-2-5\" data-name=\"navigation item\" href=\"#station\">\n                <i class=\"ti ti-calculator\" data-kid=\"1-1-2-5-1\" data-name=\"calculator icon\">\n                </i>\n                <span data-kid=\"1-1-2-5-2\" data-name=\"navigation label\">\n                    Calculadoras\n                </span>\n            </a>\n            <a class=\"nav-item\" data-kid=\"1-1-2-6\" data-name=\"navigation item\" href=\"#classification\">\n                <i class=\"ti ti-scale\" data-kid=\"1-1-2-6-1\" data-name=\"scale icon\">\n                </i>\n                <span data-kid=\"1-1-2-6-2\" data-name=\"navigation label\">\n                    CIF\n                </span>\n            </a>\n            <a class=\"nav-item\" data-kid=\"1-1-2-7\" data-name=\"navigation item\" href=\"#classification\">\n                <i class=\"ti ti-list-details\" data-kid=\"1-1-2-7-1\" data-name=\"list details icon\">\n                </i>\n                <span data-kid=\"1-1-2-7-2\" data-name=\"navigation label\">\n                    CIAP-2\n                </span>\n            </a>\n        </nav>\n        <div class=\"sidebar-bottom\" data-kid=\"1-1-3\" data-name=\"sidebar footer\">\n            <div class=\"sidebar-note\" data-kid=\"1-1-3-1\" data-name=\"system status note\">\n                <i class=\"ti ti-circle-check\" data-kid=\"1-1-3-1-1\" data-name=\"status checkmark icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"system status description\">\n                    Ambiente de estudo e apoio à decisão clínica.\n                </span>\n            </div>\n            <div class=\"sidebar-foot\" data-kid=\"1-1-3-2\" data-name=\"copyright notice\">\n                Fisio Elite Pro · 2024\n            </div>\n        </div>\n    </aside>\n    <main class=\"workspace\" data-kid=\"1-2\" data-name=\"main workspace container\">\n        <header class=\"topbar\" data-kid=\"1-2-1\" data-name=\"workspace topbar\" id=\"overview\">\n            <div class=\"breadcrumb\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb label\">\n                    Visão geral\n                </span>\n                <i class=\"ti ti-chevron-right\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb chevron icon\">\n                </i>\n                <strong data-kid=\"1-2-1-1-3\" data-name=\"current page breadcrumb strong\">\n                    Centro clínico\n                </strong>\n            </div>\n            <div class=\"global-search\" data-kid=\"1-2-1-2\" data-name=\"global search input field\" role=\"search\">\n                <i class=\"ti ti-search\" data-kid=\"1-2-1-2-1\" data-name=\"search icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"search placeholder text\">\n                    Buscar protocolos, escalas ou códigos…\n                </span>\n                <span class=\"search-hint\" data-kid=\"1-2-1-2-3\" data-name=\"search shortcut hint\">\n                    ⌘ K\n                </span>\n            </div>\n            <div class=\"workspace-context\" data-kid=\"1-2-1-3\" data-name=\"workspace context area\">\n                <span class=\"context-status\" data-kid=\"1-2-1-3-1\" data-name=\"clinical status indicator\">\n                    Plantão · UTI\n                </span>\n                <span class=\"avatar\" data-kid=\"1-2-1-3-2\" data-name=\"user avatar initials\">\n                    MA\n                </span>\n            </div>\n        </header>\n        <section aria-labelledby=\"welcome-title\" class=\"welcome\" data-kid=\"1-2-2\" data-name=\"hero welcome section\">\n            <div data-kid=\"1-2-2-1\" data-name=\"welcome text container\">\n                <p class=\"eyebrow\" data-kid=\"1-2-2-1-1\" data-name=\"welcome eyebrow\">\n                    Fisio Elite Pro\n                </p>\n                <h1 data-kid=\"1-2-2-1-2\" data-name=\"hero headline text\" id=\"welcome-title\">\n                    Decisões clínicas,\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"headline line break\"/>\n                    mais claras.\n                </h1>\n                <p class=\"welcome-copy\" data-kid=\"1-2-2-1-3\" data-name=\"welcome description text\">\n                    Um ponto de apoio para fisioterapeutas que precisam consultar escalas, protocolos e classificações com rapidez — sem perder o contexto do paciente.\n                </p>\n                <div class=\"welcome-actions\" data-kid=\"1-2-2-1-4\" data-name=\"action button container\">\n                    <a class=\"primary-action\" data-kid=\"1-2-2-1-4-1\" data-name=\"primary call-to-action button\" href=\"#shortcuts\">\n                        Explorar ferramentas\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"arrow-up-right icon\">\n                        </i>\n                    </a>\n                    <a class=\"text-action\" data-kid=\"1-2-2-1-4-2\" data-name=\"secondary link-action button\" href=\"#station\">\n                        Continuar de onde parei\n                        <i class=\"ti ti-chevron-right\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"chevron-right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <aside aria-label=\"Status do plano\" class=\"trial-note\" data-kid=\"1-2-2-2\" data-name=\"status widget\">\n                <div class=\"trial-top\" data-kid=\"1-2-2-2-1\" data-name=\"widget header\">\n                    <span data-kid=\"1-2-2-2-1-1\" data-name=\"plan name label\">\n                        Acesso profissional\n                    </span>\n                    <span class=\"trial-badge\" data-kid=\"1-2-2-2-1-2\" data-name=\"plan status badge\">\n                        Ativo\n                    </span>\n                </div>\n                <div data-kid=\"1-2-2-2-2\" data-name=\"trial details container\">\n                    <strong data-kid=\"1-2-2-2-2-1\" data-name=\"trial title\">\n                        7 dias grátis\n                    </strong>\n                    <p data-kid=\"1-2-2-2-2-2\" data-name=\"trial description\">\n                        Teste as ferramentas avançadas durante o seu próximo plantão.\n                    </p>\n                </div>\n                <div class=\"trial-line\" data-kid=\"1-2-2-2-3\" data-name=\"divider line\">\n                </div>\n                <div class=\"trial-top\" data-kid=\"1-2-2-2-4\" data-name=\"revisit time header\">\n                    <span data-kid=\"1-2-2-2-4-1\" data-name=\"revisit label\">\n                        Próxima revisão\n                    </span>\n                    <span data-kid=\"1-2-2-2-4-2\" data-name=\"revisit timestamp\">\n                        Hoje · 22:30\n                    </span>\n                </div>\n            </aside>\n        </section>\n        <section aria-labelledby=\"shortcuts-title\" class=\"section\" data-kid=\"1-2-3\" data-name=\"shortcuts section\" id=\"shortcuts\">\n            <div class=\"section-heading\" data-kid=\"1-2-3-1\" data-name=\"section header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"section title container\">\n                    <h2 data-kid=\"1-2-3-1-1-1\" data-name=\"section title\" id=\"shortcuts-title\">\n                        Atalhos clínicos\n                    </h2>\n                    <p data-kid=\"1-2-3-1-1-2\" data-name=\"section description\">\n                        O essencial para começar uma avaliação.\n                    </p>\n                </div>\n                <a class=\"section-link\" data-kid=\"1-2-3-1-2\" data-name=\"view all link\" href=\"#station\">\n                    Ver todas\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-3-1-2-1\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n            </div>\n            <div class=\"shortcut-grid\" data-kid=\"1-2-3-2\" data-name=\"shortcuts grid\">\n                <a class=\"shortcut shortcut-feature\" data-kid=\"1-2-3-2-1\" data-name=\"highlighted shortcut card\" href=\"#station\">\n                    <i class=\"ti ti-lungs\" data-kid=\"1-2-3-2-1-1\" data-name=\"lungs icon\">\n                    </i>\n                    <div class=\"shortcut-copy\" data-kid=\"1-2-3-2-1-2\" data-name=\"shortcut card content\">\n                        <small data-kid=\"1-2-3-2-1-2-1\" data-name=\"kicker label\">\n                            Em destaque\n                        </small>\n                        <strong data-kid=\"1-2-3-2-1-2-2\" data-name=\"shortcut title\">\n                            Fisioterapia Intensiva\n                        </strong>\n                        <p data-kid=\"1-2-3-2-1-2-3\" data-name=\"shortcut description\">\n                            Gasometria, mecânica ventilatória e escalas para o paciente crítico.\n                        </p>\n                    </div>\n                    <span class=\"shortcut-mark\" data-kid=\"1-2-3-2-1-3\" data-name=\"shortcut arrow indicator\">\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-3-2-1-3-1\" data-name=\"arrow-up-right icon\">\n                        </i>\n                    </span>\n                </a>\n                <a class=\"shortcut shortcut-calc\" data-kid=\"1-2-3-2-2\" data-name=\"calculator shortcut card\" href=\"#station\">\n                    <i class=\"ti ti-calculator\" data-kid=\"1-2-3-2-2-1\" data-name=\"calculator icon\">\n                    </i>\n                    <div class=\"shortcut-copy\" data-kid=\"1-2-3-2-2-2\" data-name=\"shortcut card content\">\n                        <small data-kid=\"1-2-3-2-2-2-1\" data-name=\"kicker label\">\n                            Ferramentas\n                        </small>\n                        <strong data-kid=\"1-2-3-2-2-2-2\" data-name=\"shortcut title\">\n                            Calculadoras\n                        </strong>\n                    </div>\n                    <span class=\"shortcut-mark\" data-kid=\"1-2-3-2-2-3\" data-name=\"shortcut arrow indicator\">\n                        <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"arrow-up-right icon\">\n                        </i>\n                    </span>\n                </a>\n                <a class=\"shortcut\" data-kid=\"1-2-3-2-3\" data-name=\"shortcut card\" href=\"#shortcuts\">\n                    <i class=\"ti ti-medical-cross\" data-kid=\"1-2-3-2-3-1\" data-name=\"medical cross icon\">\n                    </i>\n                    <div class=\"shortcut-copy\" data-kid=\"1-2-3-2-3-2\" data-name=\"shortcut card content\">\n                        <small data-kid=\"1-2-3-2-3-2-1\" data-name=\"kicker label\">\n                            C