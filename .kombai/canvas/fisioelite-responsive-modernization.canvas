ortcut-copy\" data-kid=\"1-2-3-2-6-2\" data-name=\"shortcut card content\">\n                        <small data-kid=\"1-2-3-2-6-2-1\" data-name=\"kicker label\">\n                            Classificação\n                        </small>\n                        <strong data-kid=\"1-2-3-2-6-2-2\" data-name=\"shortcut title\">\n                            CIAP-2\n                        </strong>\n                    </div>\n                </a>\n            </div>\n        </section>\n        <section aria-labelledby=\"station-title\" class=\"section\" data-kid=\"1-2-4\" data-name=\"workstation section\" id=\"station\">\n            <div class=\"section-heading\" data-kid=\"1-2-4-1\" data-name=\"section header\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"section title container\">\n                    <h2 data-kid=\"1-2-4-1-1-1\" data-name=\"section title\" id=\"station-title\">\n                        Estação de trabalho\n                    </h2>\n                    <p data-kid=\"1-2-4-1-1-2\" data-name=\"section description\">\n                        Ferramentas abertas para apoiar a decisão do plantão.\n                    </p>\n                </div>\n                <span class=\"section-link\" data-kid=\"1-2-4-1-2\" data-name=\"status indicator\">\n                    Atualizado agora\n                    <i class=\"ti ti-circle-check\" data-kid=\"1-2-4-1-2-1\" data-name=\"status checkmark icon\">\n                    </i>\n                </span>\n            </div>\n            <div class=\"station-grid\" data-kid=\"1-2-4-2\" data-name=\"workstation grid\">\n                <article aria-labelledby=\"gasometry-title\" class=\"panel\" data-kid=\"1-2-4-2-1\" data-name=\"gasometry panel\">\n                    <header class=\"panel-header\" data-kid=\"1-2-4-2-1-1\" data-name=\"panel header\">\n                        <div data-kid=\"1-2-4-2-1-1-1\" data-name=\"panel title container\">\n                            <p class=\"panel-kicker\" data-kid=\"1-2-4-2-1-1-1-1\" data-name=\"panel kicker label\">\n                                Fisioterapia intensiva\n                            </p>\n                            <h3 data-kid=\"1-2-4-2-1-1-1-2\" data-name=\"panel title\" id=\"gasometry-title\">\n                                Gasometria Arterial\n                            </h3>\n                            <p class=\"panel-subtitle\" data-kid=\"1-2-4-2-1-1-1-3\" data-name=\"panel subtitle\">\n                                Leitura rápida de ventilação, oxigenação e equilíbrio ácido-base.\n                            </p>\n                        </div>\n                        <span class=\"panel-code\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"panel badge\">\n                            GAS · 01\n                        </span>\n                    </header>\n                    <div aria-label=\"Abas da gasometria\" class=\"flat-tabs\" data-kid=\"1-2-4-2-1-2\" data-name=\"tab list\" role=\"tablist\">\n                        <button class=\"flat-tab active\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"active tab\" type=\"button\">\n                            Calculadora\n                        </button>\n                        <button class=\"flat-tab\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"tab\" type=\"button\">\n                            Interpretação\n                        </button>\n                        <button class=\"flat-tab\" data-kid=\"1-2-4-2-1-2-3\" data-name=\"tab\" type=\"button\">\n                            Evidências\n                        </button>\n                    </div>\n                    <div class=\"gasometry-body\" data-kid=\"1-2-4-2-1-3\" data-name=\"gasometry content body\">\n                        <div class=\"gasometry-layout\" data-kid=\"1-2-4-2-1-3-1\" data-name=\"gasometry layout grid\">\n                            <div data-kid=\"1-2-4-2-1-3-1-1\" data-name=\"form side\">\n                                <div class=\"form-heading\" data-kid=\"1-2-4-2-1-3-1-1-1\" data-name=\"form header\">\n                                    <strong data-kid=\"1-2-4-2-1-3-1-1-1-1\" data-name=\"form title\">\n                                        Dados do paciente\n                                    </strong>\n                                    <span data-kid=\"1-2-4-2-1-3-1-1-1-2\" data-name=\"form status\">\n                                        Preencha os valores\n                                    </span>\n                                </div>\n                                <form class=\"gasometry-form\" data-kid=\"1-2-4-2-1-3-1-1-2\" data-name=\"gasometry form\">\n                                    <div class=\"field patient\" data-kid=\"1-2-4-2-1-3-1-1-2-1\" data-name=\"form field\">\n                                        <label data-kid=\"1-2-4-2-1-3-1-1-2-1-1\" data-name=\"field label\" for=\"patient-name\">\n                                            Paciente\n                                        </label>\n                                        <input data-kid=\"1-2-4-2-1-3-1-1-2-1-2\" data-name=\"text input\" id=\"patient-name\" placeholder=\"Nome do paciente\" type=\"text\"/>\n                                    </div>\n                                    <div class=\"field\" data-kid=\"1-2-4-2-1-3-1-1-2-2\" data-name=\"form field\">\n                                        <label data-kid=\"1-2-4-2-1-3-1-1-2-2-1\" data-name=\"field label\" for=\"ph\">\n                                            pH\n                                        </label>\n                                        <input data-kid=\"1-2-4-2-1-3-1-1-2-2-2\" data-name=\"numeric input\" id=\"ph\" type=\"text\" value=\"7.40\"/>\n                                        <span class=\"field-ref\" data-kid=\"1-2-4-2-1-3-1-1-2-2-3\" data-name=\"field reference text\">\n                                            Ref. 7.35 — 7.45\n                                        </span>\n                                    </div>\n                                    <div class=\"field\" data-kid=\"1-2-4-2-1-3-1-1-2-3\" data-name=\"form field\">\n                                        <label data-kid=\"1-2-4-2-1-3-1-1-2-3-1\" data-name=\"field label\" for=\"paco2\">\n                                            PaCO2 (mmHg)\n                                        </label>\n                                        <input data-kid=\"1-2-4-2-1-3-1-1-2-3-2\" data-name=\"numeric input\" id=\"paco2\" type=\"text\" value=\"40\"/>\n                                        <span class=\"field-ref\" data-kid=\"1-2-4-2-1-3-1-1-2-3-3\" data-name=\"field reference text\">\n                                            Ref. 35 — 45\n                                        </span>\n                                    </div>\n                                    <div class=\"field\" data-kid=\"1-2-4-2-1-3-1-1-2-4\" data-name=\"form field\">\n                                        <label data-kid=\"1-2-4-2-1-3-1-1-2-4-1\" data-name=\"field label\" for=\"hco3\">\n                                            HCO3- (mEq/L)\n                                        </label>\n                                        <input data-kid=\"1-2-4-2-1-3-1-1-2-4-2\" data-name=\"numeric input\" id=\"hco3\" type=\"text\" value=\"24\"/>\n                                        <span class=\"field-ref\" data-kid=\"1-2-4-2-1-3-1-1-2-4-3\" data-name=\"field reference text\">\n                                            Ref. 22 — 26\n                                        </span>\n                                    </div>\n                                    <div class=\"field\" data-kid=\"1-2-4-2-1-3-1-1-2-5\" data-name=\"form field\">\n                                        <label data-kid=\"1-2-4-2-1-3-1-1-2-5-1\" data-name=\"field label\" for=\"pao2\">\n                                            PaO2 (mmHg)\n                                        </label>\n                                        <input data-kid=\"1-2-4-2-1-3-1-1-2-5-2\" data-name=\"numeric input\" id=\"pao2\" type=\"text\" value=\"95\"/>\n                                        <span class=\"field-ref\" data-kid=\"1-2-4-2-1-3-1-1-2-5-3\" data-name=\"field reference text\">\n                                            Ref. 80 — 100\n                                        </span>\n                                    </div>\n                                    <div class=\"field\" data-kid=\"1-2-4-2-1-3-1-1-2-6\" data-name=\"form field\">\n                                        <label data-kid=\"1-2-4-2-1-3-1-1-2-6-1\" data-name=\"field label\" for=\"fio2\">\n                                            FiO2 (%)\n                                        </label>\n                                        <input data-kid=\"1-2-4-2-1-3-1-1-2-6-2\" data-name=\"numeric input\" id=\"fio2\" type=\"text\" value=\"21\"/>\n                                        <span class=\"field-ref\" data-kid=\"1-2-4-2-1-3-1-1-2-6-3\" data-name=\"field reference text\">\n                                            Ref. 21\n                                        </span>\n                                    </div>\n                                    <div class=\"field\" data-kid=\"1-2-4-2-1-3-1-1-2-7\" data-name=\"form field\">\n                                        <label data-kid=\"1-2-4-2-1-3-1-1-2-7-1\" data-name=\"field label\" for=\"sao2\">\n                                            SaO2 (%)\n                                        </label>\n                                        <input data-kid=\"1-2-4-2-1-3-1-1-2-7-2\" data-name=\"numeric input\" id=\"sao2\" type=\"text\" value=\"97\"/>\n                                        <span class=\"field-ref\" data-kid=\"1-2-4-2-1-3-1-1-2-7-3\" data-name=\"field reference text\">\n                                            Ref. 95 — 100\n                                        </span>\n                                    </div>\n                                </form>\n                                <div class=\"form-actions\" data-kid=\"1-2-4-2-1-3-1-1-3\" data-name=\"form actions\">\n                                    <button class=\"action-button primary\" data-kid=\"1-2-4-2-1-3-1-1-3-1\" data-name=\"primary submit button\" type=\"button\">\n                                        Calcular\n                                    </button>\n                                    <button class=\"action-button secondary\" data-kid=\"1-2-4-2-1-3-1-1-3-2\" data-name=\"secondary reset button\" type=\"button\">\n                                        Resetar\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"result-column\" data-kid=\"1-2-4-2-1-3-1-2\" data-name=\"result display area\">\n                                <span class=\"result-label\" data-kid=\"1-2-4-2-1-3-1-2-1\" data-name=\"result label\">\n                                    Resultado clínico\n                                </span>\n                                <div class=\"primary-result\" data-kid=\"1-2-4-2-1-3-1-2-2\" data-name=\"primary result outcome box\">\n                                    <small data-kid=\"1-2-4-2-1-3-1-2-2-1\" data-name=\"result category label\">\n                                        Estado do pH\n                                    </small>\n                                    <strong data-kid=\"1-2-4-2-1-3-1-2-2-2\" data-name=\"result value\">\n                                        Faixa normal\n                                    </strong>\n                                    <p data-kid=\"1-2-4-2-1-3-1-2-2-3\" data-name=\"result description\">\n                                        Sem sinais de gravidade imediata. Manter monitorização e reavaliação seriada.\n                                    </p>\n                                </div>\n                                <div class=\"metric-list\" data-kid=\"1-2-4-2-1-3-1-2-3\" data-name=\"result metric details list\">\n                                    <div class=\"metric-row\" data-kid=\"1-2-4-2-1-3-1-2-3-1\" data-name=\"metric row\">\n                                        <span data-kid=\"1-2-4-2-1-3-1-2-3-1-1\" data-name=\"metric label\">\n                                            Distúrbio\n                                        </span>\n                                        <strong data-kid=\"1-2-4-2-1-3-1-2-3-1-2\" data-name=\"metric value\">\n                                            Aguardando\n                                        </strong>\n                                    </div>\n                                    <div class=\"metric-row\" data-kid=\"1-2-4-2-1-3-1-2-3-2\" data-name=\"metric row\">\n                                        <span data-kid=\"1-2-4-2-1-3-1-2-3-2-1\" data-name=\"metric label\">\n                                            PaO2/FiO2\n                                        </span>\n                                        <strong data-kid=\"1-2-4-2-1-3-1-2-3-2-2\" data-name=\"metric value\">\n                                            —\n                                        </strong>\n                                    </div>\n                                    <div class=\"metric-row\" data-kid=\"1-2-4-2-1-3-1-2-3-3\" data-name=\"metric row\">\n                                        <span data-kid=\"1-2-4-2-1-3-1-2-3-3-1\" data-name=\"metric label\">\n                                            Oxigenação\n                                        </span>\n                                        <strong data-kid=\"1-2-4-2-1-3-1-2-3-3-2\" data-name=\"metric value\">\n                                            Preservada\n                                        </strong>\n                                    </div>\n                                    <div class=\"metric-row\" data-kid=\"1-2-4-2-1-3-1-2-3-4\" data-name=\"metric row\">\n                                        <span data-kid=\"1-2-4-2-1-3-1-2-3-4-1\" data-name=\"metric label\">\n                                            Anion gap\n                                        </span>\n                                        <strong data-kid=\"1-2-4-2-1-3-1-2-3-4-2\" data-name=\"metric value\">\n                                            —\n                                        </strong>\n                                    </div>\n                                </div>\n                                <p class=\"result-note\" data-kid=\"1-2-4-2-1-3-1-2-4\" data-name=\"result note\">\n                                    A interpretação deve considerar hemodinâmica, perfusão e contexto ventilatório.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <article aria-labelledby=\"classification-title\" class=\"panel\" data-kid=\"1-2-4-2-2\" data-name=\"classification panel\" id=\"classification\">\n                    <header class=\"panel-header\" data-kid=\"1-2-4-2-2-1\" data-name=\"panel header\">\n                        <div data-kid=\"1-2-4-2-2-1-1\" data-name=\"panel title container\">\n                            <p class=\"panel-kicker\" data-kid=\"1-2-4-2-2-1-1-1\" data-name=\"panel kicker label\">\n                                Classificação internacional\n                            </p>\n                            <h3 data-kid=\"1-2-4-2-2-1-1-2\" data-name=\"panel title\" id=\"classification-title\">\n                                CIAP-2 · Capítulo A\n                            </h3>\n                            <p class=\"panel-subtitle\" data-kid=\"1-2-4-2-2-1-1-3\" data-name=\"panel subtitle\">\n                                Geral e inespecífico\n                            </p>\n                        </div>\n                        <span class=\"panel-code\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"panel badge\">\n                            17 CAPS\n     